# Public Moderato testnet endpoint. Override only with another verified Tempo endpoint.
TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz

# Public addresses only. These are safe to share.
RETAINER_PAYER_ADDRESS=
RETAINER_CONTRACTOR_ADDRESS=
RETAINER_TOKEN_ADDRESS=

# Never commit or paste keys into chat. A dedicated test-only access key may be
# placed here later for B1; the root wallet key must never be used by the runner.
RETAINER_ACCESS_PRIVATE_KEY=

# Local journal path.
RETAINER_DB_PATH=./data/retainer.sqlite
